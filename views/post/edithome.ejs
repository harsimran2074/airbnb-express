<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Home</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen">
    <%- include('../../partials/header') %>

    <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="overflow-hidden rounded-[2rem] border border-slate-800 bg-slate-900/95 shadow-2xl shadow-slate-950/40">
        <div class="bg-slate-900/90 px-8 py-10 text-slate-100 sm:px-12">
          <p class="text-sm uppercase tracking-[0.3em] text-slate-400">Host dashboard</p>
          <h1 class="mt-3 text-3xl font-semibold sm:text-4xl">Update your home listing</h1>
          <p class="mt-4 max-w-2xl text-slate-400">Update your title, price, rating, image, and description to keep your listing market-ready.</p>
        </div>

        <section class="px-6 py-8 sm:px-10 sm:py-10 lg:px-12">
          <form action="/host/edit-home" method="POST" class="space-y-6" 
          enctype="multipart/form-data">
            <input type="hidden" name="homeId" value="<%= home._id %>" />

            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-300" for="houseName">Home name</label>
                <input
                  id="houseName"
                  name="houseName"
                  type="text"
                  value="<%= home.homeName %>"
                  placeholder="Luxury villa in Goa"
                  class="w-full rounded-2xl border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 shadow-sm outline-none transition placeholder:text-slate-500 focus:border-slate-500 focus:ring-2 focus:ring-slate-700"
                />
              </div>

              <div>
                <label class="mb-2 block text-sm font-medium text-slate-300" for="price">Price per night</label>
                <input
                  id="price"
                  name="price"
                  type="number"
                  value="<%= home.homeprice %>"
                  placeholder="2500"
                  class="w-full rounded-2xl border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 shadow-sm outline-none transition placeholder:text-slate-500 focus:border-slate-500 focus:ring-2 focus:ring-slate-700"
                />
              </div>

              <div>
                <label class="mb-2 block text-sm font-medium text-slate-300" for="rating">Rating</label>
                <input
                  id="rating"
                  name="rating"
                  type="number"
                  step="0.1"
                  min="1"
                  max="5"
                  value="<%= home.homeRating %>"
                  placeholder="4.8"
                  class="w-full rounded-2xl border border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 shadow-sm outline-none transition placeholder:text-slate-500 focus:border-slate-500 focus:ring-2 focus:ring-slate-700"
                />
              </div>

              <div>
                <label class="mb-2 block text-sm font-medium text-slate-300" for="photo">Property image</label>
                <input
                  
                  name="photo"
                  type="file"
                  accept="image/*"
                  class="w-full rounded-2xl border border-dashed border-slate-700 bg-slate-800 px-4 py-3 text-slate-100 shadow-sm file:mr-4 file:rounded-full file:border-0 file:bg-slate-700 file:px-4 file:py-2 file:text-sm file:text-slate-100 focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-slate-300" for="description">Description</label>
              <textarea
                id="description"
                name="description"
                rows="6"
                placeholder="Describe the home amenities, nearby attractions, and guest experience."
                class="w-full rounded-2xl border border-slate-700 bg-slate-800 px-4 py-4 text-slate-100 shadow-sm outline-none transition placeholder:text-slate-500 focus:border-slate-500 focus:ring-2 focus:ring-slate-700"
              ><%= home.description %></textarea>
            </div>

            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm text-slate-400">Review the details before saving changes.</p>
              <button
                type="submit"
                class="bg-amber-500 "
              >
                Save Changes
              </button>
            </div>
          </form>
        </section>
      </div>
    </main>
  </body>
</html>
