


<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add New Home</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <style>
      input[type="file"] {
        border: 1px solid #475569;
        border-radius: 10px;
        background: #334155;
        padding: 12px 14px;
        color: white;
      }

      input[type="file"]::-webkit-file-upload-button,
      input[type="file"]::file-selector-button {
        border: 1px solid #64748b;
        border-radius: 8px;
        background: #0f172a;
        color: white;
        padding: 8px 12px;
        margin-right: 8px;
        cursor: pointer;
      }

      input[type="file"]::-webkit-file-upload-button:hover,
      input[type="file"]::file-selector-button:hover {
        background: #1e293b;
      }
    </style>
  </head>

  <body style="margin:0; background:#0f172a; color:white; font-family:Segoe UI, Arial, sans-serif;">

    <%- include('../../partials/header') %>

    <main style="
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      padding:40px;
      background:linear-gradient(135deg,#0f172a,#1e293b);
    ">

      <div style="
        width:100%;
        max-width:650px;
        background:#1e293b;
        border-radius:18px;
        padding:35px;
        box-shadow:0 15px 40px rgba(0,0,0,.45);
        border:1px solid #334155;
      ">

        <h1 style="
          text-align:center;
          margin-bottom:8px;
          color:#f8fafc;
          font-size:2rem;
        ">
          🏠 Add New Home
        </h1>

        <p style="
          text-align:center;
          color:#94a3b8;
          margin-bottom:30px;
        ">
          Fill in the details to list your property.
        </p>

        <form
          action="/host/add-home"
          method="POST"
          enctype="multipart/form-data"
        >

          <label style="display:block;margin-bottom:8px;color:#cbd5e1;">
            Home Name
          </label>

          <input
            type="text"
            name="homeName"
            placeholder="Luxury Villa"
            style="
              width:100%;
              padding:14px;
              margin-bottom:20px;
              border:none;
              border-radius:10px;
              background:#334155;
              color:white;
              font-size:16px;
              box-sizing:border-box;
            "
          />

          <label style="display:block;margin-bottom:8px;color:#cbd5e1;">
            Price per Night (₹)
          </label>

          <input
            type="number"
            name="homeprice"
            placeholder="2500"
            style="
              width:100%;
              padding:14px;
              margin-bottom:20px;
              border:none;
              border-radius:10px;
              background:#334155;
              color:white;
              font-size:16px;
              box-sizing:border-box;
            "
          />

          <label style="display:block;margin-bottom:8px;color:#cbd5e1;">
            Rating
          </label>

          <input
            type="number"
            step="0.1"
            max="5"
            min="1"
            name="homeRating"
            placeholder="4.8"
            style="
              width:100%;
              padding:14px;
              margin-bottom:20px;
              border:none;
              border-radius:10px;
              background:#334155;
              color:white;
              font-size:16px;
              box-sizing:border-box;
            "
          />

          <label style="display:block;margin-bottom:8px;color:#cbd5e1;">
            Property Image
          </label>

          <input
            type="file"
            name="photo"
            accept="image/*"
            style="
              width:100%;
              margin-bottom:20px;
              color:white;
              background:#334155;
              box-sizing:border-box;
            "
          />

          <label style="display:block;margin-bottom:8px;color:#cbd5e1;">
            Description
          </label>

          <textarea
            name="description"
            rows="5"
            placeholder="Describe your property..."
            style="
              width:100%;
              padding:14px;
              border:none;
              border-radius:10px;
              background:#334155;
              color:white;
              resize:none;
              font-size:15px;
              margin-bottom:30px;
              box-sizing:border-box;
            "
          ></textarea>

          <button
            type="submit"
            style="
              width:100%;
              padding:15px;
              border:none;
              border-radius:10px;
              background:#ef4444;
              color:white;
              font-size:17px;
              font-weight:bold;
              cursor:pointer;
              transition:.3s;
            "
            onmouseover="this.style.background='#dc2626'"
            onmouseout="this.style.background='#ef4444'"
          >
            Publish Home
          </button>

        </form>

      </div>

    </main>

  </body>
</html>