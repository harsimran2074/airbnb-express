 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Airbnb Homes</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="min-h-screen bg-slate-950 text-slate-100">
  <%- include('../../partials/header') %>

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 rounded-3xl border border-slate-800 bg-slate-900/80 px-6 py-8 shadow-2xl shadow-black/20 backdrop-blur">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-[0.3em] text-cyan-400">Host Dashboard</p>
          <h1 class="text-3xl font-bold text-white sm:text-4xl">Registered Homes</h1>
          <p class="mt-2 text-sm text-slate-400 sm:text-base">Manage your listed properties with a polished, professional view.</p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-950/70 px-4 py-3 text-sm text-slate-300">
          <span class="font-semibold text-white"><%= homeBody.length %></span> listings active
        </div>
      </div>
    </header>

    <main>
      <% if (homeBody.length === 0) { %>
        <div class="rounded-3xl border border-dashed border-slate-700 bg-slate-900/70 px-8 py-16 text-center text-slate-400">
          No homes registered yet.
        </div>
      <% } else { %>
        <ul class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          <% homeBody.forEach(home => { %>
            <li class="flex flex-col overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-xl shadow-black/20 transition duration-300 hover:-translate-y-1 hover:border-cyan-500/40">
              <div class="overflow-hidden">
                <img
                  src="<%= home.imageUrl %>"
                  alt="<%= home.homeName %>"
                  class="h-56 w-full object-cover transition duration-700 hover:scale-105"
                >
              </div>

              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-start justify-between gap-3">
                  <h2 class="text-lg font-semibold text-white"><%= home.homeName %></h2>
                  <span class="rounded-full bg-amber-500/15 px-2.5 py-1 text-sm font-semibold text-amber-400">
                    ★ <%= home.homeRating %>
                  </span>
                </div>

                <div class="mt-3 flex items-center justify-between">
                  <span class="text-lg font-semibold text-cyan-400">₹<%= home.homeprice %></span>
                  <span class="text-sm text-slate-500">/ night</span>
                </div>

                <p class="mt-3 flex-1 text-sm leading-6 text-slate-400"><%= home.description %></p>

                <div class="mt-5 flex flex-col gap-2 border-t border-slate-800 pt-4 sm:flex-row">
                  <a href="/host/edit-home/<%= home._id %>?editing=true" class="flex-1">
                    <button
                      type="button"
                      class="w-full rounded-xl bg-cyan-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-cyan-500"
                    >
                      Edit
                    </button>
                  </a>

                  <form action="/host/delete-home" method="POST" class="flex-1">
                    <input type="hidden" name="id" value="<%= home._id %>">
                    <button
                      type="submit"
                      class="w-full rounded-xl bg-red-600/90 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-red-500"
                    >
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </div>
</body>

  



   

