<!DOCTYPE html>
<html lang="en">
<head>

   <meta charset="UTF-8">

   <meta name="viewport" content="width=device-width, initial-scale=1.0">

   <title>Airbnb Homes</title>

   <link rel="stylesheet" href="/css/styles.css">

</head>



<body class="bg-gray-100 p-6">

   <header class="mb-8">

      <h1 >Here are our registered homes</h1>

   </header>
   <main class="flex flex-col items-center">

      <a  href="/host/add-home" >

         Add Home

      </a>
      <a  href="/" >

         Home page

      </a>



      <ul class="w-full max-w-xl space-y-4">

         <% homeBody.forEach((home)=> { %>

            <li class="bg-white rounded-xl shadow-md p-4 border border-gray-200">

           <div class="font-semibold text-lg">  <%= home.houseName %> </div>
           <div class="text-gray-700"> <%= home.price %> </div>
           <div class="text-yellow-500"> <%= home.rating %> </div>

            </li>

         <% }) %>

      </ul>

   </main>



</body>



</html>

