<!DOCTYPE html>

<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Airbnb Homes</title>
   <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="bg-gray-100 p-6">

   <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-rose-600 mb-2 text-center">Here are our registered homes</h1>
   </header>

   <main class="flex flex-col items-center">
      <a 
         href="/host/add-home" 
         class="inline-block px-6 py-2 mb-6 bg-rose-500 hover:bg-rose-600 text-white font-medium rounded shadow transition duration-150"
      >
         Add Home
      </a>

      <ul class="w-full max-w-xl space-y-4">
         <% homeBody.forEach((home)=> { %>
            <li class="p-4 bg-white shadow rounded flex items-center justify-between">
               <span class="text-base font-semibold text-gray-800"><%= home.houseName %></span>
            </li>
         <% }) %>
      </ul>
   </main>

</body>

</html>
