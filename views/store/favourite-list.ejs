<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Document</title>
   <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
 
  <%- include('../../partials/header') %>
   <h2>favourite list</h2>
   <ul class="w-full max-w-xl space-y-4">

         <% homeBody.forEach(home => { %>

            <li class="bg-white rounded-xl shadow-md p-4 border border-gray-200">

           <div class="font-semibold text-lg">  <%= home.homeName %> </div>
           <div class="text-gray-700"> <%= home.homeprice %> </div>
           <div class="text-yellow-500"> <%= home.homeRating %> </div>
           <div class="text-gray-700"><%= home.description %></div>

 <form action="/removeFavourite" method="post">       
<button type="submit" style="background-color: #db5213; color: #fff; padding: 0.5rem 0.75rem; border-radius: 0.75rem; border: none; cursor: pointer;">Remove</button>  
<input type="hidden" name="homeId" value="<%= home._id %>" />
</form>

            </li>

         <% }) %>

      </ul>
</body>
</html>